# Configuración de Entorno (Plantilla)
# No ingresar claves reales aquí. Usar este archivo como guía.
APP_ENV=development
DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_bd
SECRET_KEY=TU_CLAVE_SECRETA_AQUI
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:4300,https://dragoncode-front.vercel.app
DATABASE_POOL_RECYCLE_SECONDS=300
ACADEMIC_DEADLINE_CHECK_SECONDS=60
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_BLOCK_SECONDS=300
AUTO_CREATE_SCHEMA=true
SEED_INITIAL_DATA=true
